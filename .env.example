# ================================================================
# Frontend (se publican en el navegador: SOLO valores públicos)
# Copia este archivo como .env.local y completa los valores.
# ================================================================

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API Keys → anon / publishable key (es pública; RLS protege los datos)
VITE_SUPABASE_ANON_KEY=

# Página oficial de WebZipe (botón "Ir a WebZipe")
VITE_WEBZIPE_SITE_URL=https://webzipe7-byte.github.io/WebZipe/

# ================================================================
# Solo para los scripts locales (npm run create-admin / seed:dev).
# NUNCA subas esta clave a GitHub ni la pongas en variables VITE_.
# ================================================================
SUPABASE_SERVICE_ROLE_KEY=

# URL pública donde está publicada la plataforma (para los enlaces de activación)
APP_URL=http://localhost:5173/

# Dominio de correo para las cuentas DEV del script seed:dev
DEV_EMAIL_DOMAIN=example.com
